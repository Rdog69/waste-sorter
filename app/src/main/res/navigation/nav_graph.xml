<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph.xml"
    app:startDestination="@id/guidesFragment">
     <fragment
        android:id="@+id/guidesFragment"
        android:name="com.random.example.wastesorterapp.ui.guide.GuideFragment"
        android:label="fragment_guides"
        tools:layout="@layout/fragment_guides" >
         <action
             android:id="@+id/action_guidesFragment_to_guideDetailFragment"
             app:destination="@id/guideDetailFragment"
             app:enterAnim="@anim/nav_default_enter_anim"
             app:exitAnim="@anim/nav_default_exit_anim"
             app:popEnterAnim="@anim/nav_default_pop_enter_anim"
             app:popExitAnim="@anim/nav_default_pop_exit_anim" />
     </fragment>
    <fragment
        android:id="@+id/cameraFragment"
        android:name="com.random.example.wastesorterapp.ui.CameraFragment"
        android:label="fragment_camera"
        tools:layout="@layout/fragment_camera" >
        <action
            android:id="@+id/action_cameraFragment_to_resultFragment"
            app:destination="@id/resultFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/resultFragment"
        android:name="com.random.example.wastesorterapp.ui.result.ResultFragment"
        android:label="fragment_result"
        tools:layout="@layout/fragment_result">
        <argument
            android:name="imagePath"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.random.example.wastesorterapp.ui.search.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search" />
    <fragment
        android:id="@+id/guideDetailFragment"
        android:name="com.random.example.wastesorterapp.ui.guide.GuideDetailFragment"
        android:label="fragment_guide_detail"
        tools:layout="@layout/fragment_guide_detail" >
        <argument
            android:name="category_type"
            app:argType="string"
            android:defaultValue="recyclable" />
    </fragment>
</navigation>